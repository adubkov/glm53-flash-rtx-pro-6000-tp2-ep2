# Copy to .env beside compose.yaml (docker compose reads it automatically) and fill
# in. compose.yaml aborts on the required five rather than starting on an empty
# image, card, path or token.

# ---- required ----

# Absolute host path to the checkpoint directory (GLM-5.3-Flash W4A16 NVFP4 K32,
# FP8-WO). Pinned source in docs/deploy.md 2 / bench/baseline/STACK-PIN.md.
MODEL_DIR=

# Absolute host path for engine caches (torchinductor / triton / flashinfer
# cubins / pcie ipc tune). Persist it: warm caches skip minutes of JIT + autotune
# on every boot.
CACHE_DIR=

# Two RTX PRO 6000 GPUs, one UUID each. Get yours: nvidia-smi -L
GPU_ID_0=
GPU_ID_1=

# The engine's --api-key token (what clients must present as Bearer).
SGLANG_API_KEY=

# ---- optional overrides (compose.yaml default in parens) ----

# Published port (8062); server CPU affinity (2-21).
#GLM53_PORT=8062
#GLM53_CPUSET=2-21

# Pool sizing (650000 -> engine reports 649,984 at page 64) and hierarchical
# cache size in GB (16).
#GLM53_MAX_TOTAL_TOKENS=650000
#GLM53_HICACHE_SIZE_GB=16

# Prefill chunk sizes (6144 / 6144) and mamba states per path (2).
#GLM53_CHUNKED_PREFILL_SIZE=6144
#GLM53_MAX_PREFILL_TOKENS=6144
#GLM53_MAMBA_MAX_STATES_PER_PATH=2

# Quant contract label + checkpoint pin (see docs/deploy.md 2).
#GLM53_QUANTIZATION=modelopt_mixed
#GLM53_MODEL_REPOSITORY=ormandj/GLM-5.3-Flash-W4A16-NVFP4-K32-Experts-FP8-WO
#GLM53_MODEL_REVISION=ee0989a944b0e213589191d7fca63af825a0741e

# ---- image ----

# compose.yaml defaults to the public base image digest (the base the measured
# serving build was made from); the measured numbers ran on a local stage2
# build of it (two patch layers) -- docs/deploy.md §3. Build it, then pin your
# local digest here.
#SGLANG_IMAGE=sha256:<your stage2 digest>
